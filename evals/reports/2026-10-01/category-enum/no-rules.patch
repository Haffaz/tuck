+// Experimental one-field guided matcher: read the typed property directly.
+@available(macOS 26.0, *)
+func generateCategory(model: SystemLanguageModel, instructions: String, prompt: String, choices: [String]) async throws -> String {
+    let root = DynamicGenerationSchema(name:"CategoryChoice", properties:[
+        .init(name:"category", schema:DynamicGenerationSchema(name:"AllowedCategory", anyOf:choices))
+    ])
+    let schema = try GenerationSchema(root:root, dependencies:[])
+    let outputTokens = 160
+    if #available(macOS 26.4, *) {
+        let tokens = try await model.tokenCount(for:Instructions(instructions)) + model.tokenCount(for:schema) + model.tokenCount(for:Prompt(prompt))
+        guard tokens + outputTokens + 256 < model.contextSize else { throw LocalFailure(code:"context_limit") }
+    } else {
+        guard instructions.utf8.count + prompt.utf8.count + schema.debugDescription.utf8.count + outputTokens + 256 < 4096 else { throw LocalFailure(code:"context_limit") }
+    }
+    let session = LanguageModelSession(model:model, instructions:instructions)
+    let response = try await session.respond(to:prompt, schema:schema, includeSchemaInPrompt:true,
+        options:GenerationOptions(sampling:.greedy, maximumResponseTokens:outputTokens))
+    return try response.content.value(String.self, forProperty:"category")
+}
