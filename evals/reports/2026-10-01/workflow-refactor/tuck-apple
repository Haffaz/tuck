#!/usr/bin/python3
import sys,subprocess,json,time,pathlib,os
payload=sys.stdin.buffer.read() if '--check' not in sys.argv else b''
start=time.time()
p=subprocess.run(['/Users/mohomedhaffaz/Projects/tuck/src-tauri/resources/tuck-apple']+sys.argv[1:],input=payload,capture_output=True)
try:
 record={'case':os.environ.get('TUCK_TRACE_CASE','planner'),'started':start,'seconds':time.time()-start,'request':json.loads(payload) if payload else {'operation':'check'},'response':json.loads(p.stdout),'exit':p.returncode}
 pathlib.Path('/private/tmp/tuck-workflow-final/traces',str(time.time_ns())+'.json').write_text(json.dumps(record,ensure_ascii=False,indent=2))
except Exception: pass
sys.stdout.buffer.write(p.stdout)
sys.exit(p.returncode)
