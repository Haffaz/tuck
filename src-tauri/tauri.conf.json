{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuck",
  "version": "0.1.0",
  "identifier": "app.tuck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tuck",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#F8F9F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/tuck-reader",
      "resources/tuck-apple"
    ],
    "shortDescription": "A little home for every document.",
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
